# Einstellungen fuer den Feldtest. Nach einer Aenderung: ~/stop_all.sh und danach ~/start_all.sh
FRONT=-178.0      # Sensorwinkel der Gehrichtung in Grad (derselbe Wert wie lidar_front_deg bisher)
CAM_X=-0.19          # Kamera hinter dem LiDAR = negativ (m)
CAM_Y=0.0            # seitlicher Versatz, links positiv (m)
CAM_Z=0.18           # Linse ueber der LiDAR-Ebene (m)
CAM_HEIGHT=0.46      # Linsenhoehe ueber dem Boden (m)
CAM_PITCH=-1.0
WARN_DIST=1.5        # Warnabstand (m), Startwert
STOP_DIST=0.8        # Stoppabstand (m), Startwert
# Gang statt Kegel (beide Ebenen): halbe Breite = Rollator 57 cm (Rad zu Rad, aussen) / 2 + 10 cm Rand.
# Leer lassen = alter Kegel +-20 Grad. Seitenstreifen daneben: "Vorsicht, links/rechts" (kein Hindernis im Weg).
CORRIDOR_HALF_WIDTH=0.385
SIDE_WIDTH=0.35        # Breite der Seitenstreifen (m), Startwert 12.11.2026
SIDE_LENGTH=0.8        # Laenge der Seitenstreifen ab LiDAR in Gehrichtung (m), Startwert
IGNORE_SECTORS="-56..-46,-36..-16,30..40,52..60"   # Eigenechos unten (Sensorwinkel), 12.11.2026 mit scan_profile.py + Fotos: Korbknaeufe links/rechts 0,27 m, Jetson/Kabel dahinter 0,22-0,43 m, Rahmen hinten rechts 0,46 m; +-2 Grad Rand
BT_SPEAKER=F4:2B:7D:67:7D:E7   # Bluetooth-Lautsprecher (Anker SoundCore), start_all.sh verbindet ihn mit A2DP; leer = nicht verwenden (Pi: Klinke)
# Objekterkennung (camera_detector.py): Modell und Klassen (kommagetrennt, Namen wie im Modell).
# COCO (yolo11n) kennt keine Tueren; dafuer YOLO-World mit eigenen Klassen (siehe README, Jetson).
DETECT_MODEL=yolo11n.pt
DETECT_CLASSES="person,chair,couch,dining table,bench,bicycle,motorcycle,car,bus,truck,dog,cat,backpack,suitcase,umbrella,bottle,potted plant,traffic light,fire hydrant,stop sign"

# ---- Obere Ebene (zweiter LiDAR + zweite Kamera), Werte mit Zollstock messen ----
HIGH_LIDAR_PORT=/dev/serial/by-id/usb-Silicon_Labs_CP2102N_USB_to_UART_Bridge_Controller_b665612ff463ef118984e0a9c169b110-if00-port0
HIGH_CAM_DEVICE=/dev/v4l/by-path/HIER_EINTRAGEN         # ls -l /dev/v4l/by-path/  (Eintrag auf video-index0)
HIGH_FRONT=-177.0       # Sensorwinkel der Gehrichtung des oberen LiDAR (Grad); 03.11.2026 mit scan_diff.py gemessen (Person 1,5 m vorn: Mitte -177, Breite 15)
HIGH_IGNORE_SECTORS="-86..-80,78..86"   # Eigenechos oben, 12.11.2026: senkrechte Rahmenrohre links 0,33 m / rechts 0,13 m; +-2 Grad Rand
HIGH_LIDAR_X=-0.22      # oberer LiDAR gegenueber dem unteren: hinten negativ (m), mit Massband gemessen
HIGH_LIDAR_Y=-0.096     # links positiv, rechts negativ (m)
HIGH_LIDAR_Z=0.37       # Hoehe ueber dem unteren LiDAR (m); NOCH PRUEFEN: passt nicht zu HIGH_CAM_HEIGHT (siehe unten)
HIGH_CAM_X=0.0          # obere Kamera relativ zum OBEREN LiDAR; hinter dem LiDAR = negativ
HIGH_CAM_Y=0.0
HIGH_CAM_Z=0.18         # Linse ueber der oberen LiDAR-Ebene
HIGH_CAM_HEIGHT=1.18    # Linsenhoehe ueber dem Boden (mit HIGH_LIDAR_Z=0.37 und 0,28 m unten ergaebe die LiDAR-Ebene 0,65 m, mit HIGH_CAM_Z=0.18 dagegen 1,00 m: nachmessen)
HIGH_CAM_PITCH=0.0
HIGH_DETECTOR=0         # 1 = auch Objekterkennung fuer die obere Kamera (viel Rechenlast)
HIGH_CAM_ENABLE=0

# ---- Feste Geraete: by-id bleibt stabil, auch wenn Kabel umgesteckt werden ----
LIDAR_PORT=/dev/serial/by-id/usb-Silicon_Labs_CP2102N_USB_to_UART_Bridge_Controller_f656afe9036ff0118c22489b1045c30f-if00-port0   # unteres LiDAR
# Kamera: start_sensors.sh loest den Link mit readlink -f auf, weil usb_cam by-id-Links nicht selbst aufloest
CAM_BY_ID=/dev/v4l/by-id/usb-Sonix_Technology_Co.__Ltd._HD_Pro_Webcam_C920_SN0001-video-index0
